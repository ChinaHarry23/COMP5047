// secrets.h.example - copy to include/secrets.h (git-ignored) and fill in.
//
// Use a phone hotspot on WPA2 at 2.4 GHz (on iPhone: Maximize Compatibility).
// Never put a UniKey, eduroam or other personal university credential here.
// Without include/secrets.h the exhibit still builds and runs: it skips the
// live fetch and uses the cache, or the protective budget.
#pragma once

#define EDGE_WIFI_SSID "your-hotspot-name"
#define EDGE_WIFI_PASS "your-hotspot-password"

// Optional for the tag build: Unity Mac's IP. Leave undefined to broadcast
// (255.255.255.255) on the hotspot - Unity then replies to whoever it hears.
// #define EDGE_UNITY_HOST "172.20.10.2"
